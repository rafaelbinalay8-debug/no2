local function sleepWait(sec)
    local t = os.clock() + (sec or 0)
    while os.clock() < t do task.wait(0.05) end
end

local function safeClone(model)
    if not model then return nil end
    local ok, clone = pcall(function() return model:Clone() end)
    if ok and clone then
        -- matikan script di dalam model biar tidak pernah jalan
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript") then
                d:Destroy()
            end
        end
        return clone
    end
    return nil
end

local function humanVecCF(p, lookAt)
    lookAt = lookAt or (p + Vector3.new(0, 0, 1))
    return CFrame.lookAt(p, lookAt)
end

-- bekukan semua part biar clone gak jatuh / jatuhring banyak
local function setCloneFrozen(clone)
    for _, part in ipairs(clone:GetDescendants()) do
        if part:IsA("BasePart") then
            part.Anchored = true
            part.CanCollide = false
        end
    end
    if clone:IsA("Model") then
        clone.PrimaryPart = clone:FindFirstChildWhichIsA("BasePart", true)
    end
end

