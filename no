                    end
                end
            end
        end
    end
    stats.modelsFound = found
    log("Total model ORI ditemukan: " .. found
        .. " / " .. (#SECRET_BRAINROTS + #LUCKY_BLOCKS))
    if found == 0 then
        log("Hmm — model brainrot gak ketemu di folder umum. Kit tetap jalan;")
        log("1. coba SCAN MODEL lagi pas sudah di dalam game map")
        log("2. model bisa terlindung di folder yang server-lock — di-catch FuelRisk")
