--  SECTION F — JALUR SERVER-GATE (fire Server nyata)
-- ════════════════════════════════════════════════════════════════════

local function fireAllSpawnRemotes(cmd, value)
    if #SpawnRemotes == 0 then
        log("Jalur SERVER: gak ada remote spawn/event — tekan SCAN REMOTE dulu")
        return false
    end
    local fired = 0
    for _, r in ipairs(SpawnRemotes) do
        -- beberapa variasi argumen yang umum dipakai server
        local attempts = {
            { cmd, value },
            { value },
            { "Spawn", value },
            { cmd, value, true },
            { true, value },
        }
        for _, args in ipairs(attempts) do
            local ok = pcall(function()
                r:FireServer(unpack(args))
            end)
            if ok then
                fired = fired + 1
                stats.firedServer = stats.firedServer + 1
                sleepWait(0.1) -- spacing anti-spam-kick
            end
        end
    end
    log("Jalur SERVER: " .. cmd .. " '" .. tostring(value) .. "' terkirim ke "
        .. #SpawnRemotes .. " remote (" .. fired .. " attempt)")
    log("  Cek tab LOG / hasil in-game: ACCEPT = muncul nyata, REJECT = server bilang bukan admin.")
    return true
end

local function firePanelCommand(targetPlayer, cmdName)
    if #PanelRemotes == 0 then
        log("Jalur PANEL: tidak ada AdminPanelService — tekan SCAN REMOTE")
        return false
    end
    targetPlayer = targetPlayer or LocalPlayer
    local ok = false
    for _, r in ipairs(PanelRemotes) do
        local attempts = {
            { LocalPlayer, targetPlayer, cmdName },
            { targetPlayer, cmdName },
            { cmdName, targetPlayer },
            { cmdName },
        }
        for _, args in ipairs(attempts) do
            local done = pcall(function()
                r:FireServer(unpack(args))
            end)
            if done then
                ok = true
                stats.firedServer = stats.firedServer + 1
                sleepWait(0.1)
            end
        end
    end
    log("Jalur PANEL: command '" .. cmdName .. "' terkirim "
        .. (ok and "OK" or "GAGAL"))
    return ok
end

