    makeBtn(scroll, "SPAWN SEMUA SECRET SEKALIGUS", function()
        for i, n in ipairs(SECRET_BRAINROTS) do
            spawnVisual(n, i)
            sleepWait(0.08)
        end
        log("Batch: semua 12 secret brainrot ditanam di base")
    end, order, 30); order = order + 1

    makeBtn(scroll, "SPAWN SEMUA LUCKY BLOCK SEKALIGUS", function()
        for i, n in ipairs(LUCKY_BLOCKS) do
            spawnVisual(n, i)
            sleepWait(0.08)
        end
        log("Batch: semua 5 lucky block ditanam di base")
    end, order, 30); order = order + 1

    makeLbl(scroll, "JALUR SERVER-GATE / BROADCAST", 11, COLORS.accent, true).LayoutOrder = order; order = order + 1
    makeBtn(scroll, "+ coba SPawn SEMUA via FIRE SERVER", function()
        for _, n in ipairs(SECRET_BRAINROTS) do
            fireAllSpawnRemotes("SpawnBrainrot", n)
        end
    end, order, 28); order = order + 1

    makeBtn(scroll, "+ coba SPawn SEMUA via NOTIFY", function()
        for _, n in ipairs(SECRET_BRAINROTS) do
            broadcastNotify(n)
        end
    end, order, 28); order = order + 1

    makeBtn(scroll, "+ coba FORCE-OPEN PANEL ASLI", function()
        if type(getconnections) == "function" then
            for _, r in ipairs(PanelRemotes) do
                if r.ClassName == "RemoteEvent" then
                    local ok, conns = pcall(function()
                        return getconnections(r.OnClientEvent)
                    end)
                    if ok and conns then
                        for _, c in ipairs(conns) do
                            pcall(function() c:Fire() end)
                        end
                        log("Force-Open Panel fired: " .. r:GetFullName())
                    end
                end
            end
        else
            log("Executor gak support getconnections — pakai tombol SPawn via FIRE SERVER saja")
        end
    end, order, 28); order = order + 1

    -- ── LOG
    makeLbl(scroll, "LOG (hasil server-gate.Accept/Reject dsb)", 11, COLORS.accent, true).LayoutOrder = order; order = order + 1
    logBox = Instance.new("Frame")
    logBox.Size = UDim2.new(1, -10, 0, 140)
    logBox.BackgroundColor3 = Color3.fromRGB(6, 6, 8)
    logBox.LayoutOrder = order; order = order + 1
    logBox.Parent = scroll
    makeCorner(logBox, 5)

    logLabel = Instance.new("TextLabel")
    logLabel.Size = UDim2.new(1, -8, 1, -8)
    logLabel.Position = UDim2.new(0, 4, 0, 4)
    logLabel.BackgroundTransparency = 1
    logLabel.TextColor3 = COLORS.good
    logLabel.Font = Enum.Font.Code
    logLabel.TextSize = 9
    logLabel.TextXAlignment = Enum.TextXAlignment.Left
    logLabel.TextYAlignment = Enum.TextYAlignment.Top
    logLabel.TextWrapped = true
    logLabel.Parent = logBox
    LOG_CB = function()
        logLabel.Text = table.concat(LOG_LINES, "\n")
    end
    LOG_CB()

    -- drag logic
    local dragging, dragStart, startPos = false, nil, nil
    top.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging  = true
            dragStart = input.Position
            startPos  = main.Position
        end
    end)
    top.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
                                       startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    return scroll
end

