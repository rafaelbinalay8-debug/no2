local function findBaseAnchor()
    -- cari base player sendiri — biasanya workspace punya Base/<PlayerName>
    local root = nil
    -- opsi 1: folder Base/<PlayerName>
    local baseFolder = workspace:FindFirstChild("Base")
    if baseFolder then
        local my = baseFolder:FindFirstChild(LocalPlayer.Name)
        if my then
            root = my
            log("Base ditemukan: workspace.Base." .. LocalPlayer.Name)
        end
    end
    -- opsi 2: cari nama sama persis di workspace
    if not root then
        local mine = workspace:FindFirstChild(LocalPlayer.Name)
        if mine then
            root = mine
            log("Base ditemukan: workspace." .. LocalPlayer.Name)
        end
    end
    -- opsi 3: gunakan karakter sendiri
    if not root then
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        root = char
        log("Base tidak tersedia — clone menempel tepat di Character")
    end
    return root
end

local function getSpawnPos()
    local root = findBaseAnchor()
    if not root then
        return nil
    end
    local cf = nil
    if root:IsA("Model") and root.PrimaryPart then
        cf = root.PrimaryPart.CFrame
    elseif root:IsA("BasePart") then
        cf = root.CFrame
    else
        -- model tanpa primary? ambil part pertama
        local part = root:FindFirstChildWhichIsA("BasePart", true)
        if part then cf = part.CFrame end
    end
    return cf
end

local function spawnVisual(name, offsetIndex)
    local src = BrainrotModels[name]
    if not src then
        log("Model '" .. tostring(name) .. "' belum di-scan — tekan SCAN MODEL dulu")
        return false
    end
    local baseCF = getSpawnPos()
    if not baseCF then
        log("Gagal menemukan posisi base/account — model gak bisa ditanam")
        return false
    end
    local clone = safeClone(src)
    if not clone then
        log("Clone gagal untuk model: " .. tostring(name))
        return false
    end
    setCloneFrozen(clone)
    local parent = workspace

    -- susun antrean biar banyak spawn gak numpuk persis di satu titik
    local ring = math.floor((offsetIndex or 1) / 6)
    local ang   = ((offsetIndex or 1) % 6) * math.rad(60)
    local dist  = 6 + ring * 5
    local pos   = baseCF.Position + Vector3.new(
        math.cos(ang) * dist, ring * 4 + 4, math.sin(ang) * dist
    )
    local cf = humanVecCF(pos, baseCF.Position)
    pcall(function() clone:SetPrimaryPartCFrame(cf) end)
    clone.Parent = parent
    table.insert(SpawnedClones, clone)
    log("(Clone pribadi) Spawn model ORI: " .. name .. " di base kamu [#"
        .. tostring(offsetIndex or 1) .. "]")
    -- pilih biar bisa dihapus satu-satu (deler lihat tombol hapus)
    clone.Name = "[SPAWNED] " .. name
    return true
end

local function clearVisualSpawns()
    local removed = 0
    for _, clone in ipairs(SpawnedClones) do
        if clone and clone.Parent then
            clone:Destroy()
            removed = removed + 1
        end
    end
    SpawnedClones = {}
    log("Bersih visual clone: " .. removed)
end

