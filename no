local SPAWN_REMOTE_KEYS = {
    "spawn", "event", "trigger", "start",
    "launch", "give", "reward", "lucky", "admin"
}

local function isInterestingRemoteName(n)
    n = tostring(n):lower()
    if n:find("adminpanel", 1, true) then return "panel" end
    if n:find("notify", 1, true) or n:find("notif", 1, true) then return "notify" end
    for _, k in ipairs(SPAWN_REMOTE_KEYS) do
        if n:find(k, 1, true) then return "spawn" end
    end
    return nil
end

local function scanRemotes()
    SpawnRemotes = {}
    PanelRemotes = {}
    NotifyRemotes = {}
    local roots = { ReplicatedStorage, workspace, PlayerGui, game:GetService("ReplicatedFirst") }
    local seen = {}
    for _, root in ipairs(roots) do
        local ok, desc = pcall(function() return root:GetDescendants() end)
        if ok then
            for _, d in ipairs(desc) do
                if d:IsA("RemoteEvent") or d:IsA("RemoteFunction")
                   or d:IsA("UnreliableRemoteEvent") then
                    local kind = isInterestingRemoteName(d.Name)
                    if kind and not seen[d:GetFullName()] then
                        seen[d:GetFullName()] = true
                        if kind == "panel" then
                            table.insert(PanelRemotes, d)
                        elseif kind == "notify" then
                            table.insert(NotifyRemotes, d)
                        else
                            table.insert(SpawnRemotes, d)
                        end
                    end
                end
            end
        end
    end
    stats.remoteSpawnFound = #SpawnRemotes
    log("Remote: panel=" .. tonumber(#PanelRemotes)
        .. " spawn/event=" .. tonumber(#SpawnRemotes)
        .. " notify=" .. tonumber(#NotifyRemotes))
    return #SpawnRemotes
end

