        for _, node in ipairs(ReplicatedStorage:GetDescendants()) do
            if node.Name:lower():find(root:lower(), 1, true) then
                table.insert(candidates, node)
            end
        end
    end
    -- fallback: cari seluruh ReplicatedStorage / workspace
    table.insert(candidates, ReplicatedStorage)
    table.insert(candidates, workspace)

    local seen = {}
    for _, container in ipairs(candidates) do
        local ok, desc = pcall(function() return container:GetDescendants() end)
        if ok then
            for _, d in ipairs(desc) do
                if d:IsA("Model") or d:IsA("Part") then
                    for _, name in ipairs(SECRET_BRAINROTS) do
                        if d.Name == name and not seen[d.Name] then
                            BrainrotModels[d.Name] = d
                            seen[d.Name] = true
                            found = found + 1
                            log("Model ORI ditemukan: " .. d.Name
                                .. " (" .. d.ClassName .. ") @ "
                                .. (d.Parent and d.Parent:GetFullName() or "?"))
                        end
                    end
                    for _, name in ipairs(LUCKY_BLOCKS) do
                        if d.Name == name and not seen[d.Name] then
                            BrainrotModels[d.Name] = d
                            seen[d.Name] = true
                            found = found + 1
